{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@12.16.1 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@12.16.1 run web:build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/:page(move|account|qday|log|how)",
      "destination": "/:page/index.html"
    }
  ]
}
